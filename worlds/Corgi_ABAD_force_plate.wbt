# Force plates: same 2x2 layout and numbering as the lab's Vicon/Bertec plates
# (1 at +x+y, 2 at -x+y, 3 at -x-y, 4 at +x-y), 2 mm thick, 0.5 mm clear of the
# floor. Published by corgi_driver_pkg/force_plate_driver.py, which subtracts
# each plate's own weight -- keep its PLATE_MASS equal to the mass below.
Robot {
  children [
    TouchSensor {
      translation 0.305 0.205 -0.1685
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.75 0.75 0.75
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.6 0.4 0.002
          }
        }
      ]
      name "force_plate_1"
      contactMaterial "Floor"
      boundingObject Box {
        size 0.6 0.4 0.002
      }
      physics Physics {
        density -1
        mass 1
      }
      type "force-3d"
      lookupTable []
    }
    TouchSensor {
      translation -0.305 0.205 -0.1685
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.6 0.6 0.6
