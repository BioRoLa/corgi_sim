# Stair dimensions match the current new-leg planner diagnostic case:
# tread width = 0.35 m, riser height = 0.15 m, stair width = 1.00 m.
# The first riser starts at x = 0.40 m relative to the world origin.
DEF STAIR_STEP_1 Solid {
  translation 0.575 0 -0.095
  contactMaterial "Floor"
  children [
    DEF STAIR_STEP_1_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.52 0.50 0.47
        roughness 0.85
        metalness 0
      }
      geometry Box {
        size 0.35 1.00 0.15
      }
    }
  ]
  boundingObject USE STAIR_STEP_1_SHAPE
}
